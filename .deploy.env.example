# Copy sang `.deploy.env` (file này bị gitignore) rồi điền thông tin VPS.
#   cp .deploy.env.example .deploy.env && chmod 600 .deploy.env
#
# SSH bằng key — cấp một lần: ssh-copy-id -p <port> <user>@<host>

VPS_HOST=
VPS_USER=root
VPS_PORT=22

# Thư mục chạy trên VPS (script tự tạo nếu chưa có)
VPS_PATH=/opt/studio-manage

# Domain dùng để kiểm chứng sau deploy (cert trong /etc/letsencrypt/live/<domain>)
DOMAIN=

# Tên compose project. ĐỪNG đổi — volume Mongo là `<project>_mongodb_data`,
# đổi tên = khởi động vào một database rỗng.
COMPOSE_PROJECT=studio-manage
