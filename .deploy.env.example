# Copy sang `.deploy.env` (file này bị gitignore) rồi điền thông tin NAS.
#   cp .deploy.env.example .deploy.env && chmod 600 .deploy.env

# SSH tới NAS
NAS_HOST=nas.example.com
NAS_USER=your-nas-user
NAS_PORT=22

# Cách xác thực SSH — chọn 1:
#
# (a) Password: điền vào đây. Bắt buộc dùng cách này nếu DSM đang TẮT user home
#     service, vì khi đó không tồn tại ~/.ssh/authorized_keys để đặt SSH key.
#     Script đưa mật khẩu qua SSH_ASKPASS nên nó không lộ trong `ps`.
#
# (b) SSH key (sạch hơn, khuyến nghị): bật DSM → Control Panel → User & Group →
#     Advanced → User Home → "Enable user home service", rồi chạy
#         ssh-copy-id -p <port> <user>@<host>
#     và ĐỂ TRỐNG NAS_SSH_PASSWORD.
NAS_SSH_PASSWORD=

# Thư mục chạy trên NAS. Dùng thư mục MỚI, đừng trỏ vào thư mục git clone cũ.
# Script tự tạo nếu chưa có.
NAS_PATH=/volume1/<share>/code/studio-manage-release

# Synology bắt buộc sudo để gọi docker. Để trống nếu user chạy được docker không cần sudo.
NAS_SUDO_PASSWORD=

# Tên compose project. ĐỪNG đổi — volume Mongo là `<project>_mongodb_data`,
# đổi tên = compose tạo volume RỖNG mới, coi như mất dữ liệu.
COMPOSE_PROJECT=studio-manage
