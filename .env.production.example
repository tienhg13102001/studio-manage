# Env production — MỘT file duy nhất cho cả stack trên VPS.
# Copy thành `.env.production` (bị gitignore), hoặc lấy bản đang chạy về bằng:
#   ./deploy.sh env:pull
# Sửa xong đẩy lên:  ./deploy.sh env   (in key thay đổi, hỏi xác nhận, backup bản cũ)
# Trên VPS file này nằm ở <VPS_PATH>/.env, dùng chung cho docker compose + backend.

# ── Hạ tầng (docker compose) ─────────────────────────────────────────────────
# Mật khẩu root Mongo. CHỈ đặt một lần lúc khởi tạo DB — đổi ở đây KHÔNG đổi mật khẩu
# trong DB đã có (deploy.sh sẽ chặn).
MONGO_ROOT_PASSWORD=
# Cổng phụ để chạy thử; bỏ trống = 80/443
# HTTP_PORT=8080
# HTTPS_PORT=8443

# ── Backend ──────────────────────────────────────────────────────────────────
# MONGO_URI, NODE_ENV, PORT do docker-compose.yml đặt — không khai báo ở đây.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS (comma-separated nếu nhiều origin)
# CORS_ORIGIN=https://example.com

SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# Telegram bot (thông báo lịch chụp) — webhook: https://<domain>/api/telegram/webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Google Apps Script Web App — tạo folder Drive & ghi Sheet khi tạo lịch
GAS_WEBHOOK_URL=
GAS_WEBHOOK_SECRET=
